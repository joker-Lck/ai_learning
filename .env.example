# ============================================================
# AI 学习智能体系统 - 环境变量配置
# ============================================================
# 使用步骤:
#   1. 复制此文件:  cp .env.example .env
#   2. 编辑 .env，填入实际值（至少填写【必需】项）
#   3. 运行检查脚本:  .venv\Scripts\python.exe check_env.py
#   4. 初始化数据库:  .venv\Scripts\python.exe init_databases_v7.2.py
#   5. 启动系统:      启动.bat
# ============================================================

# ========== 【必需】安全配置 ==========
# JWT 密钥 — 用于登录 Token 签名，使用任意 32 位以上随机字符串
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_secret_key_here_at_least_32_chars

# ========== 【必需】AI 配置（Kimi / Moonshot） ==========
# 在 https://platform.moonshot.cn 注册并获取 API Key
# 这是系统的核心 AI 能力，没有此 Key 则所有 AI 功能不可用
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 按任务复杂度选择模型（可选，有默认值）
# KIMI_MODEL_SIMPLE=kimi-k2.5          # 简单任务（推理模型）
# KIMI_MODEL_STANDARD=kimi-k2.5        # 标准任务（推理模型）
# KIMI_MODEL_ADVANCED=kimi-k2.6        # 复杂任务（高级推理）
# KIMI_MODEL_ULTRA=kimi-k2.6           # 最强推理
# KIMI_MODEL_VISION=moonshot-v1-32k-vision-preview  # 图片识别

# ========== 【必需】MySQL 数据库配置 ==========
# 系统使用 7 个独立数据库，请确保 MySQL 8.0+ 已安装并运行
# 所有数据库使用相同的 root 密码（生产环境建议使用独立用户）

# 认证数据库（用户登录注册）
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your_mysql_password_here
AUTH_DB_NAME=ai_auth

# 学生画像数据库（课程表、成绩、错题、学习计划、画像）
PROFILE_DB_HOST=localhost
PROFILE_DB_PORT=3306
PROFILE_DB_USER=root
PROFILE_DB_PASSWORD=your_mysql_password_here
PROFILE_DB_NAME=ai_profiles

# 学习资源数据库
RESOURCES_DB_HOST=localhost
RESOURCES_DB_PORT=3306
RESOURCES_DB_USER=root
RESOURCES_DB_PASSWORD=your_mysql_password_here
RESOURCES_DB_NAME=ai_resources

# 学习路径数据库
PATHS_DB_HOST=localhost
PATHS_DB_PORT=3306
PATHS_DB_USER=root
PATHS_DB_PASSWORD=your_mysql_password_here
PATHS_DB_NAME=ai_paths

# 智能辅导数据库
TUTOR_DB_HOST=localhost
TUTOR_DB_PORT=3306
TUTOR_DB_USER=root
TUTOR_DB_PASSWORD=your_mysql_password_here
TUTOR_DB_NAME=ai_tutor

# 学习评估数据库
ASSESSMENTS_DB_HOST=localhost
ASSESSMENTS_DB_PORT=3306
ASSESSMENTS_DB_USER=root
ASSESSMENTS_DB_PASSWORD=your_mysql_password_here
ASSESSMENTS_DB_NAME=ai_assessments

# 智能体协作数据库
AGENTS_DB_HOST=localhost
AGENTS_DB_PORT=3306
AGENTS_DB_USER=root
AGENTS_DB_PASSWORD=your_mysql_password_here
AGENTS_DB_NAME=ai_agents

# RAG 知识库数据库
RAG_DB_HOST=localhost
RAG_DB_PORT=3306
RAG_DB_USER=root
RAG_DB_PASSWORD=your_mysql_password_here
RAG_DB_NAME=ai_rag_knowledge

# ========== 【可选】其他配置 ==========
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 文件上传大小限制 (MB)
MAX_UPLOAD_SIZE=50

# RAG 检索相似度阈值 (0-1)
RAG_SIMILARITY_THRESHOLD=0.8

# ========== 【可选】视频生成 API ==========
# 支持: kling (可灵), zhipu (智谱 CogVideoX)
# 不配置则自动降级为 AI 生成 SVG 交互动画
# VIDEO_API_PROVIDER=kling
# VIDEO_API_KEY=your_video_api_key_here
