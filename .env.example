# AI Learning System Config

# Security
JWT_SECRET=your_random_secret_key_here_at_least_32_chars

# Application
DEBUG=false
APP_VERSION=7.2.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Spark AI
SPARK_APPID=your_app_id_here
SPARK_API_KEY=your_api_key_here
SPARK_API_SECRET=your_api_secret_here
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1
SPARK_MODEL=spark-x

# Image
SPARK_IMAGE_APPID=your_app_id_here
SPARK_IMAGE_API_KEY=your_image_api_key_here
SPARK_IMAGE_API_SECRET=your_image_api_secret_here
SPARK_IMAGE_URL=https://spark-api.cn-huabei-1.xf-yun.com/v2.1/tti

# OCR
SPARK_OCR_APPID=your_app_id_here
SPARK_OCR_API_KEY=your_ocr_api_key_here
SPARK_OCR_API_SECRET=your_ocr_api_secret_here
SPARK_OCR_URL=https://cbm01.cn-huabei-1.xf-yun.com/v1/private/se75ocrbm

# TTS
SPARK_TTS_APPID=your_app_id_here
SPARK_TTS_API_KEY=your_tts_api_key_here
SPARK_TTS_API_SECRET=your_tts_api_secret_here
SPARK_TTS_URL=https://api-dx.xf-yun.com/v1/private/dts_create

# Embedding
SPARK_EMBEDDING_URL=https://emb-cn-huabei-1.xf-yun.com/

# Databases
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_USER=root
AUTH_DB_PASSWORD=your_mysql_password_here
AUTH_DB_NAME=ai_auth

PROFILE_DB_HOST=localhost
PROFILE_DB_PORT=3306
PROFILE_DB_USER=root
PROFILE_DB_PASSWORD=your_mysql_password_here
PROFILE_DB_NAME=ai_profiles

RESOURCES_DB_HOST=localhost
RESOURCES_DB_PORT=3306
RESOURCES_DB_USER=root
RESOURCES_DB_PASSWORD=your_mysql_password_here
RESOURCES_DB_NAME=ai_resources

PATHS_DB_HOST=localhost
PATHS_DB_PORT=3306
PATHS_DB_USER=root
PATHS_DB_PASSWORD=your_mysql_password_here
PATHS_DB_NAME=ai_paths

TUTOR_DB_HOST=localhost
TUTOR_DB_PORT=3306
TUTOR_DB_USER=root
TUTOR_DB_PASSWORD=your_mysql_password_here
TUTOR_DB_NAME=ai_tutor

ASSESSMENTS_DB_HOST=localhost
ASSESSMENTS_DB_PORT=3306
ASSESSMENTS_DB_USER=root
ASSESSMENTS_DB_PASSWORD=your_mysql_password_here
ASSESSMENTS_DB_NAME=ai_assessments

AGENTS_DB_HOST=localhost
AGENTS_DB_PORT=3306
AGENTS_DB_USER=root
AGENTS_DB_PASSWORD=your_mysql_password_here
AGENTS_DB_NAME=ai_agents

RAG_DB_HOST=localhost
RAG_DB_PORT=3306
RAG_DB_USER=root
RAG_DB_PASSWORD=your_mysql_password_here
RAG_DB_NAME=ai_rag_knowledge

MEMORY_DB_HOST=localhost
MEMORY_DB_PORT=3306
MEMORY_DB_USER=root
MEMORY_DB_PASSWORD=your_mysql_password_here
MEMORY_DB_NAME=ai_memory

# Other
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=50
RAG_SIMILARITY_THRESHOLD=0.8
