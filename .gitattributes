# Auto detect text files and perform LF normalization
* text=auto

# Batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must use LF
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
